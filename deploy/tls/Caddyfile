# Local TLS terminator in front of the Go API (HTTP on :8080).
#   caddy run --config deploy/tls/Caddyfile
#
# Point the API at this proxy with:
#   TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
#   REQUIRE_TLS=true
#
# Production TLS belongs on Ingress (deploy/k8s/ingress.yaml), not this file.

{
	local_certs
}

https://localhost:8443 {
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
